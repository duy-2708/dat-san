# Chép các dòng dưới đây đè vào file .env của project (giữ nguyên APP_KEY đã sinh)

APP_NAME="Đặt Sân"
APP_URL=http://datsan.test
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_TIMEZONE=Asia/Ho_Chi_Minh

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dat_san
DB_USERNAME=root
DB_PASSWORD=

# Local: email ghi vào storage/logs/laravel.log (mở file để bấm link xác thực).
# Laragon có sẵn Mail Catcher: đổi thành MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025 để xem thư trên trình duyệt.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@datsan.test"
MAIL_FROM_NAME="${APP_NAME}"

QUEUE_CONNECTION=database

# Đăng nhập Google — tạo tại https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://datsan.test/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback
