# File .env cho MÁY CHỦ THẬT. cai-may-chu.sh tự chép thành .env và điền APP_URL, DB_PASSWORD, APP_KEY.
# Phần MAIL_* và GOOGLE_*: chép từ file .env trên máy bạn (đừng gửi file này cho ai, đừng commit lên git).

APP_NAME="Đặt Sân"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TEN_MIEN
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_TIMEZONE=Asia/Ho_Chi_Minh

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dat_san
DB_USERNAME=dat_san
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Gmail: dùng Mật khẩu ứng dụng (16 ký tự), giới hạn ~500 thư/ngày — đủ cho ~20 sân.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback

# ---- Bảo mật ----
BAT_BUOC_2FA_ADMIN=true
GIOI_HAN_TOC_DO=true
GIOI_HAN_GUI_MOI_PHUT=40
GIOI_HAN_NHAY_CAM=5
SAO_LUU_GIU_NGAY=14
NHAT_KY_GIU_NGAY=180
